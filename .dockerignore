# Docker only reads .dockerignore from the build context root, and every
# service in docker-compose.yaml builds with `context: .` — so this one file
# governs all four images.

.git
.gitignore
.github

# Virtualenvs dominate the context (~780MB across the five services).
.venv
**/.venv
venv
env

__pycache__
**/__pycache__
*.pyc
*.pyo
*.egg-info
**/*.egg-info

.pytest_cache
**/.pytest_cache
.ruff_cache
.mypy_cache

# Secrets and local state must never enter an image layer.
.env
**/.env
*.db
**/*.db
*.log
**/*.log

# Not needed at runtime. Note src/core/README.md is deliberately NOT excluded:
# core is built as a wheel inside the images and its pyproject declares it.
**/tests
/docs
/Makefile
/docker-compose.yaml
/docker-compose.override.yaml
