<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Swiss Sports Bet — cross-bookmaker odds</title>
<style>
  :root {
    --bg: #0a0a0a;
    --panel: #101010;
    --raised: #161616;
    --line: #262626;
    --line-soft: #1c1c1c;
    --ink: #ededed;
    --muted: #8a8a8a;
    --dim: #6a6a6a;
    --best: #e0e0e0;
    --arb: #3ecf8e;
    --arb-dim: #14301f;
    --arb-line: rgba(62, 207, 142, .22);
    --warm: #e0a33c;
  }
  /* Not an inversion: the light board needs its own weights to stay as quiet. */
  :root:has(#theme:checked) {
    --bg: #fbfbfa;
    --panel: #ffffff;
    --raised: #f5f5f3;
    --line: #e2e2de;
    --line-soft: #ececea;
    --ink: #1a1a18;
    --muted: #6b6b65;
    --dim: #87877f;
    --best: #1a1a18;
    --arb: #0b7a45;
    --arb-dim: #e8f4ed;
    --arb-line: rgba(11, 122, 69, .25);
    --warm: #a9741c;
  }
  :root { color-scheme: dark; }
  :root:has(#theme:checked) { color-scheme: light; }
  * { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; }
  body {
    margin: 0;
    padding: 0 1rem 5rem;
    background: var(--bg);
    color: var(--ink);
    font: 400 14px/1.45 -apple-system, BlinkMacSystemFont, "Segoe UI", Inter, Roboto, sans-serif;
    -webkit-font-smoothing: antialiased;
  }
  main { max-width: 52rem; margin: 0 auto; }
  a { color: inherit; }

  /* Header: one line of identity, one of provenance. */
  header {
    display: flex; align-items: baseline; gap: .625rem; flex-wrap: wrap;
    padding: 2.25rem 0 1.25rem;
  }
  h1 {
    font-size: .9375rem; font-weight: 600; margin: 0; letter-spacing: -.005em;
  }
  .flag { opacity: .9; }
  .meta {
    margin-left: auto; font-size: .75rem; color: var(--dim);
    font-variant-numeric: tabular-nums;
  }
  .meta a { color: var(--muted); text-decoration: none; border-bottom: 1px solid var(--line); }
  .meta a:hover { color: var(--ink); }

  #theme { position: absolute; width: 1px; height: 1px; opacity: 0; }
  .theme {
    cursor: pointer; user-select: none; font-size: .6875rem; color: var(--muted);
    border: 1px solid var(--line); border-radius: 4px; padding: .2rem .5rem;
    background: var(--panel); white-space: nowrap;
  }
  .theme:hover { color: var(--ink); border-color: var(--dim); }
  #theme:focus-visible + .theme { outline: 2px solid var(--warm); outline-offset: 2px; }
  .theme .on-light { display: none; }
  :root:has(#theme:checked) .theme .on-dark { display: none; }
  :root:has(#theme:checked) .theme .on-light { display: inline; }

  /* Counts sit inline, not in tiles: the numbers are small facts, not headlines. */
  .counts {
    display: flex; gap: 1.75rem; padding: .75rem 1rem; margin-bottom: 1.5rem;
    background: var(--panel); border: 1px solid var(--line); border-radius: 6px;
  }
  .counts div { display: flex; align-items: baseline; gap: .5rem; }
  .counts .n { font-size: .9375rem; font-weight: 600; font-variant-numeric: tabular-nums; }
  .counts .k {
    font-size: .6875rem; color: var(--muted); text-transform: uppercase; letter-spacing: .06em;
  }
  .counts .hit .n { color: var(--arb); }

  /* Column ruler, aligned to the row grid below. */
  .ruler, .row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 3.75rem repeat(3, 3.25rem) 4.5rem;
    align-items: center;
    gap: .5rem;
  }
  .ruler {
    padding: 0 1rem .4rem; font-size: .625rem; letter-spacing: .09em;
    text-transform: uppercase; color: var(--dim);
  }
  .ruler span:not(:first-child) { text-align: right; }

  .board {
    background: var(--panel); border: 1px solid var(--line); border-radius: 6px;
    overflow: hidden;
  }
  details { border-top: 1px solid var(--line-soft); }
  details:first-child { border-top: 0; }
  summary { list-style: none; cursor: pointer; }
  summary::-webkit-details-marker { display: none; }

  .row { padding: .4rem 1rem; min-height: 2.25rem; }
  summary:hover .row { background: var(--raised); }
  details[open] .row { background: var(--raised); }

  .fix { min-width: 0; display: flex; align-items: baseline; gap: .5rem; }
  .name {
    font-weight: 500; font-size: .8125rem;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }
  .day { font-size: .6875rem; color: var(--dim); white-space: nowrap; }
  .time {
    font-size: .75rem; color: var(--muted); text-align: right;
    font-variant-numeric: tabular-nums;
  }
  .odd {
    text-align: right; font-size: .8125rem; font-variant-numeric: tabular-nums;
    color: var(--best);
  }
  .odd.none { color: var(--dim); }
  .mrg {
    text-align: right; font-size: .75rem; color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
  details.arb .mrg { color: var(--arb); font-weight: 600; }
  details.arb .name { color: var(--arb); }

  /* Expanded detail. */
  .drawer { padding: .25rem 1rem 1rem; background: var(--raised); }
  .drawer h2 {
    font-size: .625rem; text-transform: uppercase; letter-spacing: .09em;
    color: var(--dim); font-weight: 600; margin: 1rem 0 .4rem;
  }
  table { width: 100%; border-collapse: collapse; font-size: .8125rem; }
  th {
    text-align: right; font-weight: 500; font-size: .625rem; color: var(--dim);
    text-transform: uppercase; letter-spacing: .07em;
    padding: .3rem .5rem; border-bottom: 1px solid var(--line);
  }
  th:first-child, td:first-child { text-align: left; }
  td {
    padding: .35rem .5rem; border-bottom: 1px solid var(--line-soft);
    text-align: right; font-variant-numeric: tabular-nums; color: var(--muted);
  }
  td:first-child { color: var(--ink); }
  tr:last-child td { border-bottom: 0; }
  td.best { color: var(--ink); font-weight: 600; }
  td.best::after { content: "·"; color: var(--warm); margin-left: .3rem; }
  /* The link is the bookmaker's name, so it carries no colour of its own: an
     underline on hover is enough, and keeps the table reading as a table. */
  a.book { text-decoration: none; }
  a.book:hover { text-decoration: underline; }
  .out { color: var(--dim); font-size: .625rem; margin-left: .25rem; }
  a.book:hover .out { color: var(--muted); }
  .note {
    margin: .875rem 0 0; padding: .5rem .75rem; font-size: .75rem;
    color: var(--arb); background: var(--arb-dim);
    border: 1px solid var(--arb-line); border-radius: 4px;
  }
  .empty {
    padding: 3rem 1rem; text-align: center; color: var(--muted); font-size: .8125rem;
    background: var(--panel); border: 1px solid var(--line); border-radius: 6px;
  }
  footer {
    margin-top: 1.5rem; color: var(--dim); font-size: .6875rem; line-height: 1.6;
  }

  @media (max-width: 36rem) {
    .ruler, .row { grid-template-columns: minmax(0, 1fr) repeat(3, 2.9rem) 4rem; }
    .ruler .c-time, .row .time { display: none; }
    .counts { flex-direction: column; gap: .4rem; }
  }
</style>
</head>
<body>
<main>
  <header>
    <h1><span class="flag">🇨🇭</span> Swiss Sports Bet</h1>
    <span class="meta">
      1X2 · Loro vs Swisslos · {{ generated_at }} ·
      <a href="https://github.com/tremgan/swiss-sports-bet">source</a>
    </span>
    <input type="checkbox" id="theme">
    <label class="theme" for="theme">
      <span class="on-dark">Light</span><span class="on-light">Dark</span>
    </label>
  </header>

  <div class="counts">
    <div><span class="n">{{ fixtures | length }}</span><span class="k">priced by both</span></div>
    <div{% if arbitrage_count %} class="hit"{% endif %}>
      <span class="n">{{ arbitrage_count }}</span><span class="k">arbitrage</span>
    </div>
  </div>

  {% if not fixtures %}
    <p class="empty">No fixture is currently priced by more than one bookmaker.</p>
  {% else %}
  <div class="ruler">
    <span>Fixture</span><span class="c-time">Kick-off</span>
    <span>1</span><span>X</span><span>2</span><span>Margin</span>
  </div>

  <div class="board">
    {% for fixture in fixtures %}
    <details{% if fixture.has_arbitrage %} class="arb" open{% endif %}>
      <summary>
        <div class="row">
          <span class="fix">
            <span class="name">{{ fixture.label }}</span>
            <span class="day">{{ fixture.kickoff_day }}</span>
          </span>
          <span class="time">{{ fixture.kickoff_time }}</span>
          {% for col in fixture.columns %}
          <span class="odd{% if col.price is none %} none{% endif %}">
            {{ "%.2f"|format(col.price) if col.price is not none else "—" }}
          </span>
          {% endfor %}
          <span class="mrg">{{ "%+.2f"|format(fixture.margin_pct) }}%</span>
        </div>
      </summary>

      <div class="drawer">
        <h2>Every price</h2>
        <table>
          <tr><th>Bookmaker</th><th>Home</th><th>Draw</th><th>Away</th><th>Updated</th></tr>
          {% for b in fixture.bookmakers %}
          <tr>
            <td>
              {% if b.url %}
              <a class="book" href="{{ b.url }}" rel="noopener noreferrer nofollow" target="_blank">{{ b.name }}<span class="out" aria-hidden="true">&#8599;</span></a>
              {% else %}
              {{ b.name }}
              {% endif %}
            </td>
            <td{% if "team1" in b.best %} class="best"{% endif %}>{{ b.team1_odds }}</td>
            <td{% if "draw" in b.best %} class="best"{% endif %}>{{ b.draw_odds if b.draw_odds else "—" }}</td>
            <td{% if "team2" in b.best %} class="best"{% endif %}>{{ b.team2_odds }}</td>
            <td>{{ b.updated }}</td>
          </tr>
          {% endfor %}
        </table>

        <h2>Best price per outcome</h2>
        <table>
          <tr><th>Outcome</th><th>Bookmaker</th><th>Odds</th><th>Stake</th></tr>
          {% for best in fixture.best_odds %}
          <tr>
            <td>{{ best.outcome }}</td>
            <td>{{ best.bookmaker }}</td>
            <td>{{ best.price }}</td>
            <td>{{ "%.1f%%"|format(best.stake_pct) if best.stake_pct is not none else "—" }}</td>
          </tr>
          {% endfor %}
        </table>

        {% if fixture.has_arbitrage %}
        <p class="note">
          Staking as above returns {{ "%.2f"|format(fixture.profit_pct) }}% whichever way the match ends.
        </p>
        {% endif %}
      </div>
    </details>
    {% endfor %}
  </div>
  {% endif %}

  <footer>
    Educational project. Odds are a snapshot at generation time and move constantly,
    so a margin shown here may be gone already.
  </footer>
</main>
</body>
</html>
