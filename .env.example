# A reference, not a file to copy. Actions supplies these from repository
# secrets, and nothing reads a .env — a copy at the repo root used to be found
# by anything started anywhere inside it, production included. For a local run,
# name the database on the command line instead:
#
#   DATABASE_URL="sqlite:///dev.db" uv run uvicorn main:app --port 8000

# Read by db_service and by alembic. Use the Supabase *session pooler* URI
# (port 5432): the direct connection is IPv6-only, which a GitHub Actions
# runner cannot reach, and the transaction pooler on 6543 keeps no session
# state for alembic. Rewrite the scheme to `postgresql+psycopg://`, since
# this project installs psycopg 3 and a bare `postgresql://` URI sends
# SQLAlchemy looking for psycopg2. Percent-encode specials in the password.
DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:PASSWORD@REGION.pooler.supabase.com:5432/postgres?sslmode=require

# Where the scrapers and the report reach the API.
DB_SERVICE_URL=http://127.0.0.1:8000

# How often each scraper runs.
SCRAPE_FREQUENCY_HOURS=3
