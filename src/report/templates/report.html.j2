<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Swiss Sports Bet — cross-bookmaker odds</title>
<style>
  :root {
    --bg: #fbfbfa; --panel: #fff; --ink: #1a1a19; --muted: #6b6b68;
    --line: #e3e3e0; --arb: #1a7f4b; --arb-bg: #e8f5ee; --best: #0b5fa5;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #17181a; --panel: #1f2023; --ink: #e8e8e6; --muted: #9a9a96;
      --line: #32343a; --arb: #4ddb90; --arb-bg: #15301f; --best: #6cb6ff;
    }
  }
  * { box-sizing: border-box; }
  body {
    margin: 0; padding: 2rem 1rem 4rem; background: var(--bg); color: var(--ink);
    font: 16px/1.55 -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }
  main { max-width: 56rem; margin: 0 auto; }
  h1 { font-size: 1.5rem; margin: 0 0 .25rem; letter-spacing: -.01em; }
  .sub { color: var(--muted); font-size: .875rem; margin: 0 0 2rem; }
  .sub a { color: inherit; }
  .tally {
    display: flex; gap: 2rem; padding: 1rem 1.25rem; margin-bottom: 1.5rem;
    background: var(--panel); border: 1px solid var(--line); border-radius: 10px;
  }
  .tally div { display: flex; flex-direction: column; }
  .tally .n { font-size: 1.5rem; font-weight: 600; font-variant-numeric: tabular-nums; }
  .tally .k { font-size: .75rem; color: var(--muted); text-transform: uppercase; letter-spacing: .04em; }
  details {
    background: var(--panel); border: 1px solid var(--line);
    border-radius: 10px; margin-bottom: .5rem;
  }
  details[open] { border-color: var(--muted); }
  details.arb { border-color: var(--arb); background: var(--arb-bg); }
  summary {
    cursor: pointer; padding: .875rem 1.25rem; display: flex;
    align-items: baseline; gap: .75rem; flex-wrap: wrap;
  }
  summary::marker { color: var(--muted); }
  .fixture { font-weight: 600; }
  .kickoff { color: var(--muted); font-size: .8125rem; }
  .margin { margin-left: auto; font-variant-numeric: tabular-nums; font-size: .875rem; color: var(--muted); }
  .badge {
    background: var(--arb); color: var(--bg); font-size: .6875rem; font-weight: 700;
    padding: .15rem .45rem; border-radius: 4px; text-transform: uppercase; letter-spacing: .04em;
  }
  .body { padding: 0 1.25rem 1.25rem; }
  h2 { font-size: .75rem; text-transform: uppercase; letter-spacing: .06em;
       color: var(--muted); margin: 1.25rem 0 .5rem; font-weight: 600; }
  table { width: 100%; border-collapse: collapse; font-size: .9375rem; }
  th { text-align: right; font-weight: 600; font-size: .75rem; color: var(--muted);
       padding: .35rem .5rem; border-bottom: 1px solid var(--line); }
  th:first-child, td:first-child { text-align: left; }
  td { padding: .4rem .5rem; border-bottom: 1px solid var(--line);
       text-align: right; font-variant-numeric: tabular-nums; }
  tr:last-child td { border-bottom: 0; }
  td.best { color: var(--best); font-weight: 600; }
  .profit { margin-top: 1rem; padding: .75rem 1rem; border-radius: 8px;
            background: var(--arb); color: var(--bg); font-weight: 600; font-size: .9375rem; }
  .empty { padding: 3rem 1.25rem; text-align: center; color: var(--muted);
           background: var(--panel); border: 1px solid var(--line); border-radius: 10px; }
  footer { margin-top: 2.5rem; color: var(--muted); font-size: .8125rem; }
</style>
</head>
<body>
<main>
  <h1>🇨🇭 Swiss Sports Bet</h1>
  <p class="sub">
    1X2 football odds compared across Loro and Swisslos · generated {{ generated_at }} ·
    <a href="https://github.com/tremgan/swiss-sports-bet">source</a>
  </p>

  <div class="tally">
    <div><span class="n">{{ fixtures | length }}</span><span class="k">Fixtures priced by both</span></div>
    <div><span class="n">{{ arbitrage_count }}</span><span class="k">Arbitrage opportunities</span></div>
  </div>

  {% if not fixtures %}
    <p class="empty">No fixture is currently priced by more than one bookmaker.</p>
  {% endif %}

  {% for fixture in fixtures %}
  <details{% if fixture.has_arbitrage %} class="arb" open{% endif %}>
    <summary>
      <span class="fixture">{{ fixture.label }}</span>
      <span class="kickoff">{{ fixture.kickoff }}</span>
      {% if fixture.has_arbitrage %}<span class="badge">arb {{ "%.2f"|format(fixture.profit_pct) }}%</span>{% endif %}
      <span class="margin">margin {{ "%+.2f"|format(fixture.margin_pct) }}%</span>
    </summary>
    <div class="body">
      <h2>Every price</h2>
      <table>
        <tr><th>Bookmaker</th><th>Home</th><th>Draw</th><th>Away</th><th>Updated</th></tr>
        {% for b in fixture.bookmakers %}
        <tr>
          <td>{{ b.name }}</td>
          <td{% if "team1" in b.best %} class="best"{% endif %}>{{ b.team1_odds }}</td>
          <td{% if "draw" in b.best %} class="best"{% endif %}>{{ b.draw_odds if b.draw_odds else "—" }}</td>
          <td{% if "team2" in b.best %} class="best"{% endif %}>{{ b.team2_odds }}</td>
          <td>{{ b.updated }}</td>
        </tr>
        {% endfor %}
      </table>

      <h2>Best price per outcome</h2>
      <table>
        <tr><th>Outcome</th><th>Bookmaker</th><th>Odds</th><th>Stake</th></tr>
        {% for best in fixture.best_odds %}
        <tr>
          <td>{{ best.outcome }}</td>
          <td>{{ best.bookmaker }}</td>
          <td>{{ best.price }}</td>
          <td>{{ "%.1f%%"|format(best.stake_pct) if best.stake_pct is not none else "—" }}</td>
        </tr>
        {% endfor %}
      </table>

      {% if fixture.has_arbitrage %}
      <p class="profit">
        Staking as above returns {{ "%.2f"|format(fixture.profit_pct) }}% whichever way the match ends.
      </p>
      {% endif %}
    </div>
  </details>
  {% endfor %}

  <footer>
    Educational project. Odds are a snapshot at generation time and move constantly —
    a margin shown here may be gone already.
  </footer>
</main>
</body>
</html>
