# Copy to .env at the repo root: `cp .env.example .env`

# Postgres credentials, consumed by docker-compose.
POSTGRES_USER=sportsbet
POSTGRES_PASSWORD=change-me
POSTGRES_DB=sportsbet

# Read by db_service. Compose builds this from the values above; set it by hand
# for local runs, e.g. sqlite:///dev.db
DATABASE_URL=sqlite:///dev.db

# Where the scrapers and dashboard reach the API.
DB_SERVICE_URL=http://127.0.0.1:8000

# How often each scraper runs.
SCRAPE_FREQUENCY_HOURS=3
